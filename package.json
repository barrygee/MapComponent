{
    "name": "sentinel",
    "private": true,
    "engines": {
        "node": ">=24.0.0 <26.0.0",
        "npm": ">=11.0.0 <12.0.0"
    },
    "scripts": {
        "build:spa": "npm run build --prefix frontend/vue",
        "typecheck": "tsc --noEmit",
        "test:e2e:fullstack": "playwright test -c playwright.fullstack.config.ts",
        "lint": "eslint . && prettier --check \"tests/**/*.ts\" \"*.{js,ts}\"",
        "lint:fix": "eslint . --fix && prettier --write \"tests/**/*.ts\" \"*.{js,ts}\"",
        "format": "prettier --write \"tests/**/*.ts\" \"*.{js,ts}\"",
        "format:check": "prettier --check \"tests/**/*.ts\" \"*.{js,ts}\"",
        "prepare": "husky"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.61.0",
        "@types/node": "^24.13.3",
        "eslint": "^10.4.1",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.0.7",
        "maplibre-gl": "^4.5.0",
        "prettier": "^3.8.3",
        "typescript": "^5.4.0",
        "typescript-eslint": "^8.61.0"
    }
}
